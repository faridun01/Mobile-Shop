{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue.bold,green.bold \"npm run server\" \"npm run dev:frontend\"",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "dev:backend": "npm run server",
    "build": "vite build",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=server/dist/index.mjs",
    "build:native": "vite build --mode native",
    "native:sync": "npm run build:native && cap sync",
    "native:ios": "cap open ios",
    "native:android": "cap open android",
    "postinstall": "prisma generate",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/test-e2e-isolated.ts",
    "test:system": "tsx scripts/test-system-audit.ts",
    "test:quarter": "tsx scripts/test-quarter-simulation.ts",
    "test:project-audit": "tsx scripts/test-project-audit.ts",
    "test:quarter-business": "tsx scripts/test-quarter-business.ts",
    "test:audit-load": "tsx scripts/test-audit-load.ts",
    "test:auth-matrix": "tsx scripts/audit-ui-contracts.ts && tsx scripts/test-api-auth-matrix.ts",
    "test:page-loading": "npm run build && tsx scripts/test-page-loading.ts && tsx scripts/test-page-recovery.ts",
    "test:data-load-recovery": "npm run build && tsx scripts/test-data-load-recovery.ts && tsx scripts/test-data-load-recovery.ts --partial",
    "test:cycle200": "tsx scripts/test-business-cycle-200.ts",
    "audit:ui-contracts": "tsx scripts/audit-ui-contracts.ts",
    "test:ui": "npm run build && tsx scripts/test-ui-audit.ts",
    "test:sn-camera": "npm run build && tsx scripts/test-sn-camera.ts",
    "test:profit-refund": "tsx scripts/test-profit-share-refund.ts",
    "test:sales-cancellation": "tsx scripts/test-sales-cancellation.ts",
    "test:shift-corrections": "tsx scripts/test-shift-corrections.ts",
    "test:sale-edits": "tsx scripts/test-sale-edits.ts",
    "test:exchange-closed-shift": "tsx scripts/test-exchange-after-closed-shift.ts",
    "test:invoice-edit": "tsx scripts/test-invoice-edit-delete.ts",
    "test:exchange-profit": "tsx scripts/test-exchange-profit-report.ts",
    "test:full-cycle": "tsx scripts/test-full-business-cycle.ts",
    "test:audit-fixes": "tsx scripts/test-audit-fixes.ts",
    "test:functional": "tsx scripts/test-functional-audit.ts",
    "test:cash-collection": "tsx scripts/test-cash-collection.ts",
    "test:store-receipt": "tsx scripts/test-store-receipt.ts",
    "test:bonus-rules": "tsx scripts/test-bonus-rules.ts",
    "test:collection-split": "tsx scripts/test-collection-bonus-split.ts",
    "test:store-merge": "tsx scripts/test-store-merge.ts",
    "test:bonus-admin": "tsx scripts/test-bonus-admin.ts",
    "audit:system": "tsx scripts/audit-system.ts",
    "audit:owners": "tsx scripts/check-owner-balances.ts",
    "check:full-cycle": "tsx scripts/full-cycle-check.ts",
    "audit:bonus-collections": "tsx scripts/reconcile-bonus-collections.ts",
    "fix:unbacked-payments": "tsx scripts/fix-unbacked-customer-payments.ts",
    "fix:unbacked-payments:apply": "tsx scripts/fix-unbacked-customer-payments.ts --apply",
    "db:clean": "tsx scripts/clear-data-keep-users.ts",
    "db:reset-operations": "tsx scripts/reset-operations.ts",
    "db:reset-operations:apply": "tsx scripts/reset-operations.ts --apply",
    "demo:week": "tsx scripts/demo-week.ts",
    "phones:clean": "tsx scripts/rebuild-clean-phone-catalog.ts",
    "phones:rebuild": "tsx scripts/rebuild-clean-phone-catalog.ts",
    "server": "tsx watch server/src/index.ts"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "8.2.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@prisma/client": "^6.12.0",
    "dotenv": "^17.2.3",
    "exceljs": "^3.4.0",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "prisma": "^6.12.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "tsx": "^4.21.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.5",
    "esbuild": "0.25.12",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "shell-quote": "^1.12.0"
  }
}

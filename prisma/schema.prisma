datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  ADMIN
  PARTNER
  SELLER
}

enum DeviceStatus {
  MAIN_WAREHOUSE
  STORE_STOCK
  SOLD
  IN_STOCK_AFTER_EXCHANGE
  IN_REPAIR
  TRANSFER_PENDING
}

enum RepairStatus {
  ACCEPTED
  IN_PROGRESS
  READY
  ISSUED
  DIAGNOSTICS
  IN_REPAIR
  DELIVERED
  UNREPAIRABLE
}

enum TransferStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  CARD
  SPLIT
  DEBT
}

enum SaleStatus {
  COMPLETED
  EXCHANGED
  REFUNDED
}

enum BonusType {
  FREE_DEVICES
  CASH_DISCOUNT
}

enum OwnerTransactionType {
  INVESTMENT
  WITHDRAWAL
  PROFIT_PAYOUT
  REINVEST
}

enum LedgerType {
  SALE
  CASH_SALE
  CARD_SALE
  PURCHASE
  EXPENSE
  SALARY
  SUPPLIER_PAYMENT
  OWNER_INVESTMENT
  OWNER_CAPITAL_WITHDRAWAL
  OWNER_PROFIT_PAYOUT
  OWNER_REINVESTMENT
  EXCHANGE_SETTLEMENT
  SUPPLIER_BONUS
  TRANSFER
  REFUND
  CUSTOMER_PAYMENT
}

model Store {
  id              String   @id @default(uuid())
  name            String
  address         String?
  isMainWarehouse Boolean  @default(false)
  cashBalanceTjs  Float    @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users            User[]
  devices          Device[]
  sales            Sale[]
  repairs          RepairTicket[]
  expenses         Expense[]
  transfersFrom    TransferRequest[] @relation("FromStore")
  transfersTo      TransferRequest[] @relation("ToStore")
  purchaseInvoices SupplierInvoice[]

  @@map("stores")
}

model User {
  id                     String   @id @default(uuid())
  login                  String   @unique
  password               String
  name                   String
  role                   Role     @default(SELLER)
  active                 Boolean  @default(true)
  storeId                String?
  baseSalaryTjs          Float?
  salesCommissionPercent Float?
  pin                    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  store         Store?         @relation(fields: [storeId], references: [id])
  sales         Sale[]
  repairs       RepairTicket[]
  auditLogs     AuditLog[]
  notifications Notification[]
  ownerProfile  Owner?

  @@map("users")
}

model Device {
  id                String       @id @default(uuid())
  imei              String       @unique
  // A phone's second (dual-SIM) IMEI is a real hardware identifier and must never
  // repeat across devices — nullable @unique gives Postgres a partial unique index
  // that allows unlimited NULLs (most devices have no second slot) while rejecting
  // any duplicate non-null value.
  imei2             String?      @unique
  serialNumber      String?
  brand             String
  model             String
  ram               String?
  storage           String
  color             String
  status            DeviceStatus @default(MAIN_WAREHOUSE)
  storeId           String
  purchasePriceUsd  Float
  costBasisUsd      Float
  retailPriceTjs    Float?
  receivedDate      DateTime?
  isBonus           Boolean      @default(false)
  bonusCampaign     String?
  supplierId        String?
  supplierName      String?
  invoiceNumber     String?
  purchaseInvoiceId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  store           Store                 @relation(fields: [storeId], references: [id])
  supplier        Supplier?             @relation(fields: [supplierId], references: [id])
  purchaseInvoice SupplierInvoice?      @relation(fields: [purchaseInvoiceId], references: [id])
  timeline        DeviceTimelineEvent[]
  saleItems       SaleItem[]
  repairTickets   RepairTicket[]
  transferItems   TransferItem[]

  @@index([imei])
  @@index([storeId, status])
  @@index([status])
  @@map("devices")
}

model DeviceTimelineEvent {
  id          String   @id @default(uuid())
  deviceId    String
  date        DateTime @default(now())
  type        String
  description String
  userName    String
  storeName   String?
  priceTjs    Float?
  priceUsd    Float?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("device_timeline_events")
}

model Sale {
  id                       String        @id @default(uuid())
  receiptNumber            Int           @unique @default(autoincrement())
  storeId                  String
  userId                   String
  customerName             String?
  customerId               String?
  totalTjs                 Float
  totalUsd                 Float
  exchangeRate             Float?
  paymentMethod            PaymentMethod
  cashAmountTjs            Float         @default(0)
  cardAmountTjs            Float         @default(0)
  // Amount still owed by the customer on this specific sale — 0 for every normal
  // (fully paid at checkout) sale, so existing sales/reporting are unaffected.
  // Only DEBT-method sales start with this > 0, decremented as CustomerPayments land.
  debtAmountTjs            Float         @default(0)
  exchangeTradeInCreditTjs Float?
  status                   SaleStatus    @default(COMPLETED)
  hasBelowCostItem         Boolean       @default(false)
  refundReason             String?
  refundedAt               DateTime?
  refundedByUserId         String?
  penaltyFeeTjs            Float?
  penaltyFeeUsd            Float?
  actualRefundAmountTjs    Float?
  createdAt                DateTime      @default(now())

  store              Store                       @relation(fields: [storeId], references: [id])
  user               User                        @relation(fields: [userId], references: [id])
  customer           Customer?                   @relation(fields: [customerId], references: [id])
  saleItems          SaleItem[]
  exchangeEvents     ExchangeEvent[]
  paymentAllocations CustomerPaymentAllocation[]

  @@index([storeId, createdAt])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id              String  @id @default(uuid())
  saleId          String
  deviceId        String
  brand           String
  model           String
  storage         String
  color           String
  imei            String
  imei2           String?
  salePriceTjs    Float
  salePriceUsd    Float
  purchaseCostUsd Float
  costBasisUsd    Float
  isBelowCost     Boolean @default(false)

  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id])

  @@index([saleId])
  @@index([deviceId])
  @@map("sale_items")
}

model ExchangeEvent {
  id                  String         @id @default(uuid())
  saleId              String
  date                DateTime       @default(now())
  returnedDeviceId    String
  returnedImei        String
  returnedModel       String
  exchangeInValueTjs  Float
  exchangeInValueUsd  Float
  replacementDeviceId String
  replacementImei     String
  replacementModel    String
  newPriceTjs         Float
  newPriceUsd         Float
  differenceTjs       Float
  paymentMethod       PaymentMethod?
  cashAmountTjs       Float?
  cardAmountTjs       Float?
  processedByUserId   String

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("exchange_events")
}

model Supplier {
  id                String   @id @default(uuid())
  name              String
  phone             String?
  contactPerson     String?
  totalPurchasedUsd Float    @default(0)
  totalPaidUsd      Float    @default(0)
  totalDebtUsd      Float    @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  devices  Device[]
  invoices SupplierInvoice[]
  bonuses  SupplierBonus[]
  payments SupplierPayment[]

  @@map("suppliers")
}

model SupplierInvoice {
  id              String   @id @default(uuid())
  invoiceNumber   String
  supplierId      String
  date            DateTime @default(now())
  totalAmountUsd  Float
  paidAmountUsd   Float    @default(0)
  devicesCount    Int      @default(0)
  isStorePurchase Boolean  @default(false)
  storeId         String?

  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  store       Store?                      @relation(fields: [storeId], references: [id])
  groups      InvoiceGroup[]
  devices     Device[]
  allocations SupplierPaymentAllocation[]

  @@index([supplierId])
  @@index([storeId])
  @@map("supplier_invoices")
}

model InvoiceGroup {
  id               String @id @default(uuid())
  invoiceId        String
  brand            String
  model            String
  ram              String?
  storage          String
  color            String
  quantity         Int
  purchasePriceUsd Float

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_groups")
}

model SupplierPayment {
  id              String   @id @default(uuid())
  supplierId      String
  amountUsd       Float
  sourceAccount   String
  storeId         String?
  createdByUserId String
  createdAt       DateTime @default(now())

  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  allocations SupplierPaymentAllocation[]

  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id                 String @id @default(uuid())
  paymentId          String
  invoiceId          String
  allocatedAmountUsd Float

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id])

  @@map("supplier_payment_allocations")
}

// A customer is identified by phone number (unique, when provided) rather than
// free-text name alone — the same customer must always resolve to the same record
// across multiple debt sales/payments, so support staff can never end up unsure
// which "Иван" a payment belongs to the way the shop previously had duplicate stores.
model Customer {
  id           String   @id @default(uuid())
  name         String
  phone        String?  @unique
  totalDebtTjs Float    @default(0)
  totalPaidTjs Float    @default(0)
  createdAt    DateTime @default(now())

  sales    Sale[]
  payments CustomerPayment[]

  @@map("customers")
}

model CustomerPayment {
  id              String   @id @default(uuid())
  customerId      String
  amountTjs       Float
  sourceAccount   String
  storeId         String?
  createdByUserId String
  createdAt       DateTime @default(now())

  customer    Customer                    @relation(fields: [customerId], references: [id])
  allocations CustomerPaymentAllocation[]

  @@index([customerId])
  @@map("customer_payments")
}

model CustomerPaymentAllocation {
  id                 String @id @default(uuid())
  paymentId          String
  saleId             String
  allocatedAmountTjs Float

  payment CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale    Sale            @relation(fields: [saleId], references: [id])

  @@index([paymentId])
  @@index([saleId])
  @@map("customer_payment_allocations")
}

model SupplierBonus {
  id            String    @id @default(uuid())
  supplierId    String
  campaignTitle String?
  bonusType     BonusType
  amountUsd     Float?
  status        String?
  dateReceived  DateTime  @default(now())
  createdAt     DateTime  @default(now())

  supplier    Supplier              @relation(fields: [supplierId], references: [id])
  freeDevices SupplierBonusDevice[]

  @@map("supplier_bonuses")
}

model SupplierBonusDevice {
  id           String  @id @default(uuid())
  bonusId      String
  deviceId     String?
  brand        String
  model        String
  storage      String
  color        String
  imei         String
  costBasisUsd Float

  bonus SupplierBonus @relation(fields: [bonusId], references: [id], onDelete: Cascade)

  @@map("supplier_bonus_devices")
}

model TransferRequest {
  id                String         @id @default(uuid())
  transferNumber    String         @unique
  fromStoreId       String
  toStoreId         String
  status            TransferStatus @default(PENDING_APPROVAL)
  requestedByUserId String
  requestedAt       DateTime       @default(now())
  approvedByUserId  String?
  approvedAt        DateTime?
  rejectedReason    String?
  updatedAt         DateTime       @updatedAt

  fromStore Store          @relation("FromStore", fields: [fromStoreId], references: [id])
  toStore   Store          @relation("ToStore", fields: [toStoreId], references: [id])
  items     TransferItem[]

  @@index([fromStoreId])
  @@index([toStoreId])
  @@map("transfer_requests")
}

model TransferItem {
  id         String @id @default(uuid())
  transferId String
  deviceId   String
  imei       String
  model      String

  transfer TransferRequest @relation(fields: [transferId], references: [id], onDelete: Cascade)
  device   Device          @relation(fields: [deviceId], references: [id])

  @@index([transferId])
  @@index([deviceId])
  @@map("transfer_items")
}

model RepairTicket {
  id                 String       @id @default(uuid())
  ticketNumber       Int          @unique @default(autoincrement())
  storeId            String
  userId             String
  deviceId           String?
  imei               String
  imei2              String?
  brand              String
  model              String
  storage            String?
  color              String?
  saleReceiptNumber  Int?
  saleDate           DateTime?
  customerName       String?
  customerPhone      String?
  prepaymentTjs      Float?
  problemDescription String
  visualCondition    String?
  equipmentPackage   String?
  comment            String?
  status             RepairStatus @default(ACCEPTED)
  estimatedCostTjs   Float?
  finalCostTjs       Float?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  store         Store                 @relation(fields: [storeId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])
  device        Device?               @relation(fields: [deviceId], references: [id])
  statusHistory RepairStatusHistory[]

  @@index([storeId, status])
  @@map("repair_tickets")
}

model RepairStatusHistory {
  id              String       @id @default(uuid())
  ticketId        String
  status          RepairStatus
  updatedAt       DateTime     @default(now())
  updatedByUserId String
  note            String?

  ticket RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("repair_status_history")
}

model Expense {
  id                   String   @id @default(uuid())
  category             String
  amountTjs            Float
  amountUsd            Float?
  exchangeRate         Float?
  targetType           String   @default("STORE")
  storeId              String?
  sourceAccount        String?
  comment              String?
  description          String?
  createdByUserId      String
  paidFromCashRegister Boolean  @default(true)
  employeeId           String?
  isEmployeeAdvance    Boolean  @default(false)
  createdAt            DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
  @@index([createdAt])
  @@map("expenses")
}

model Owner {
  id                    String   @id @default(uuid())
  // Links this capital/profit record to the actual login account of the business
  // partner it belongs to, so the name is never a manually-copied snapshot that can
  // drift out of sync — nullable because a legacy/silent investor may have no login.
  userId                String?  @unique
  name                  String
  profitSharePercent    Float
  capitalBalanceUsd     Float    @default(0)
  totalAccruedProfitUsd Float    @default(0)
  totalPaidProfitUsd    Float    @default(0)
  totalReinvestedUsd    Float    @default(0)
  availableProfitUsd    Float    @default(0)
  createdAt             DateTime @default(now())

  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactions OwnerTransaction[]

  @@map("owners")
}

model OwnerTransaction {
  id                  String               @id @default(uuid())
  ownerId             String
  type                OwnerTransactionType
  amountUsd           Float
  sourceOrDestination String?
  createdByUserId     String
  note                String?
  createdAt           DateTime             @default(now())

  owner Owner @relation(fields: [ownerId], references: [id])

  @@index([ownerId, createdAt])
  @@map("owner_transactions")
}

model QuarterClosure {
  id             String   @id @default(uuid())
  quarterName    String
  closedByUserId String
  snapshot       Json
  closedAt       DateTime @default(now())

  @@map("quarter_closures")
}

model ExchangeRate {
  id              String    @id @default(uuid())
  date            String    @unique
  rate            Float
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedByUserId String?
  updatedAt       DateTime?

  @@map("exchange_rates")
}

model Notification {
  id           String    @id @default(uuid())
  title        String
  message      String
  targetType   String?
  targetId     String?
  targetRoute  String?
  targetRole   Role?
  targetUserId String?
  read         Boolean   @default(false)
  resolved     Boolean   @default(false)
  readAt       DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [targetUserId], references: [id])

  @@index([targetUserId, read])
  @@index([targetRole, read])
  @@map("notifications")
}

model AuditLog {
  id               String   @id @default(uuid())
  userId           String?
  userName         String?
  userRole         String?
  storeName        String?
  action           String
  details          String
  financialDetails Json?
  imei             String?
  receiptNumber    Int?
  targetId         String?
  ipAddress        String?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("audit_logs")
}

model LedgerEntry {
  id           String     @id @default(uuid())
  type         LedgerType
  description  String
  amountTjs    Float?
  amountUsd    Float?
  exchangeRate Float?
  storeId      String?
  storeName    String?
  userName     String?
  referenceId  String?
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@map("ledger_entries")
}

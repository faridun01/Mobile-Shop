# APP_URL: The URL where this app is hosted locally.
APP_URL="http://localhost:3000"

# DATABASE_URL: Local Docker PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5435/mobile_shop_db?schema=public"

# In production against a pooled connection string (e.g. Supabase's session
# pooler), append connection_limit and pool_timeout so Prisma's own client-side
# pool doesn't exceed what the upstream pooler allows, e.g.:
# ?schema=public&connection_limit=10&pool_timeout=20

# JWT_SECRET: Secret key for local development authentication tokens.
# REQUIRED — the server refuses to boot without it (see server/src/auth/auth.service.ts).
# Generate a real random value for any shared/staging/production environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="local-dev-only-secret-do-not-use-in-prod-3f8a9c2e1b6d4f70"

# Backend server API port
PORT="3001"

# BUSINESS_TIME_ZONE: OPTIONAL. IANA timezone used to compute the current "business day"
# for daily exchange-rate lookups and TODAY/MONTH report filtering. Defaults to
# "Asia/Tashkent" if unset (see getBusinessDateKey in exchange-rate.service.ts).
# BUSINESS_TIME_ZONE="Asia/Tashkent"

# NODE_ENV: set to "production" in any real deployment — this is what makes APP_URL
# mandatory (no wildcard CORS fallback) at server boot. Leave unset for local dev.
# NODE_ENV="production"

# --- Frontend build-time vars (Vite — must be set at BUILD time, not runtime) ---

# VITE_API_URL: OPTIONAL. Only needed if the frontend is built to call the API at an
# absolute URL instead of the default relative "/api" (which relies on same-origin
# serving, or a proxy/rewrite like vercel.json's /api/* rewrite, to reach the backend).
# VITE_API_URL="https://your-api-host.example.com/api"

# VITE_WS_URL: OPTIONAL, but REQUIRED for realtime sync (live cross-terminal updates —
# sales, transfers, notifications) to work on a split-domain deployment such as the
# current Vercel (frontend) + Render (backend) setup in vercel.json. Vercel's `rewrites`
# proxy plain HTTP/HTTPS requests (that's how /api/* reaches Render transparently) but do
# NOT proxy WebSocket upgrades — without this var, the frontend tries to open a WebSocket
# to its OWN origin's /ws path, which vercel.json has no route for, and the connection
# silently fails (see the try/catch in src/hooks/useRealtimeSync.ts). Point it directly at
# the backend's own WebSocket endpoint instead:
# VITE_WS_URL="wss://mobile-shop-api-6ct5.onrender.com/ws"
